// ----- Blur Waybar and Popups -----
layer-rule {
    match namespace="waybar"
    popups {
        background-effect {
            blur true
            xray false
        }
    }
    background-effect {
        blur true
        xray true
    }
}
// ----- Blur Layers with Xray Disabled -----
layer-rule {
    match namespace="notifications"
    match namespace="wofi"
    background-effect {
        blur true
        xray false
    }
}
// ----- Open Apps Maximized -----
window-rule {
    match app-id="^firefox$"
    match app-id="^spotify$"
    match app-id="^vesktop$"
    match app-id="^org.qbittorrent.qBittorrent$"
    match app-id="Minecraft"
    match app-id="^com.obsproject.Studio$"
    open-maximized true
}
// ----- Open Apps Floating -----
window-rule {
    match app-id="^mpv$"
    match app-id="^org.prismlauncher.PrismLauncher$"
    match app-id="^org.gnome.Loupe$"
    open-floating true
}
// ----- Open Firefox Library Floating and not Maximized -----
window-rule {
    match app-id="^firefox$" title="Library"
    open-floating true
    open-maximized false
}
// ----- Open Nautilus Floating with custom widht and height -----
window-rule {
    match app-id="^org.gnome.Nautilus$"
    open-floating true
    default-column-width {
        proportion 0.8
    }
    default-window-height {
        proportion 0.8
    }
}
